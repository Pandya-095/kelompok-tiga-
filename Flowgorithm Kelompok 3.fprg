<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Hitung Durasi Rapi"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value="Program Menghitung Durasi Waktu"/>
        <attribute name="saved" value="2026-09-17 11:37:17 AM"/>
        <attribute name="created" value="Vml0byBOYW5kcmlhbjtMQVBUT1AtNk0xME9RUjA7MjAyNi0wOS0xNjswNDowMDo1MiBQTTszNTY5"/>
        <attribute name="edited" value="Vml0byBOYW5kcmlhbjtMQVBUT1AtNk0xME9RUjA7MjAyNi0wOS0xNjswNzo0ODo1NSBQTTszOzM2OTc="/>
        <attribute name="edited" value="Rm9yZSBTdG9yZTtGT1JFLVNUT1JFOzIwMjYtMDktMTc7MTE6Mzc6MTcgQU07MTszMDc5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Again" type="String" array="False" size=""/>
            <assign variable="Again" expression="&quot;y&quot;"/>
            <while expression="Again = &quot;y&quot; or again = &quot;Y&quot;">
                <declare name="StartHour" type="Integer" array="False" size=""/>
                <output expression="&quot;Masukkan Jam Mulai (0-23):&quot;" newline="True"/>
                <do expression="StartHour&lt;0 or StartHour&gt;23">
                    <input variable="StartHour"/>
                </do>
                <declare name="StartMinute" type="Integer" array="False" size=""/>
                <output expression="&quot;Masukkan Menit Mulai (0-59):&quot;" newline="True"/>
                <do expression="StartMinute&lt;0 or StartMinute&gt;59">
                    <input variable="StartMinute"/>
                </do>
                <declare name="EndHour" type="Integer" array="False" size=""/>
                <output expression="&quot;Masukkan Jam Selesai (0-23):&quot;" newline="True"/>
                <do expression="EndHour&lt;0 or EndHour&gt;23">
                    <input variable="EndHour"/>
                </do>
                <declare name="EndMinute" type="Integer" array="False" size=""/>
                <output expression="&quot;Masukkan Menit Selesai (0-59):&quot;" newline="True"/>
                <do expression="EndMinute&lt;0 or EndMinute&gt;59">
                    <input variable="EndMInute"/>
                </do>
                <declare name="StartTotal" type="Integer" array="False" size=""/>
                <assign variable="StartTotal" expression="(StartHour * 60) + StartMinute"/>
                <declare name="EndTotal" type="Integer" array="False" size=""/>
                <assign variable="EndTotal" expression="(EndHour * 60) + EndMinute"/>
                <if expression="EndTotal &lt; StartTotal">
                    <then>
                        <assign variable="EndTotal" expression="EndTotal + 1440"/>
                    </then>
                    <else/>
                </if>
                <declare name="Duration" type="Integer" array="False" size=""/>
                <assign variable="Duration" expression="EndTotal - StartTotal"/>
                <declare name="DurationMinute" type="Integer" array="False" size=""/>
                <assign variable="DurationMinute" expression="Duration % 60"/>
                <declare name="DurationHour" type="Integer" array="False" size=""/>
                <assign variable="DurationHour" expression="(Duration - DurationMinute) / 60"/>
                <output expression="&quot;Durasi: &quot; &amp; DurationHour &amp; &quot; jam &quot; &amp; DurationMinute &amp; &quot; menit&quot;" newline="True"/>
                <output expression="&quot;Apakah ingin menghitung lagi? (y/n):&quot;" newline="True"/>
                <input variable="Again"/>
            </while>
            <output expression="&quot;Program selesai. Terima kasih!&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
